# ═══ GaiaPi Docker Ignore ═══
# Keep the image atomic and light

# Heavy media (mount as volumes instead)
paintings/*.jpg
paintings/*.png
paintings/*.jpeg
videos/*.mp4
videos/*.webm
sounds/*.wav
sounds/*.mp3
img_b64/

# Node modules (rebuilt in container)
node_modules/
golgi/node_modules/

# Git
.git/
.gitignore

# IDE
.vscode/
.cursor/

# Logs and temp
*.log
membrane-out.txt
membrane-err.txt

# Executables (wrong platform)
BioMOS.exe
*.msi
*.exe

# Injection scripts
inject_paintings.js
inject_p1.js

# Dev files
PINNED.md
TURBOCHARGE-PROTOCOL.md
*.md

# Series gallery images
series/
Blink-Exhibition/
Night-Terrors-Series/
Micro-Biology-Series/
