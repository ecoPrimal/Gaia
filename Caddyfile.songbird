# ═══════════════════════════════════════════════════════════════════
#  CADDY — SONGBIRD FEATHERS
#  
#  Routes all traffic to the membrane. The feathers that let her fly.
#  Inside Docker: Caddy(:80/:443) → Membrane(:31415)
#  
#  The songbird sings through Caddy.
#  The tower stands on Node.
#  The bones are Rust.
#  The eyes are Chipmunk.
# ═══════════════════════════════════════════════════════════════════

# When running with a domain (production)
# Replace {$GAIA_DOMAIN:localhost} with your domain
{$GAIA_DOMAIN:localhost}:80 {

	# ─── API routes → Membrane ───
	handle /api/* {
		reverse_proxy localhost:31415
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		header X-Membrane-Metal gold
		header X-Songbird tower-atomic
	}
	handle /api {
		reverse_proxy localhost:31415
		header X-Membrane-Metal gold
	}

	# ─── RSS feeds → vagus nerve ───
	handle /rss/* {
		reverse_proxy localhost:31415
		header Access-Control-Allow-Origin *
		header X-Membrane-Metal gold
		header X-Gaia-Channel rss-vagus
	}
	handle /rss {
		reverse_proxy localhost:31415
	}

	# ─── OpenAI compat → Membrane ───
	handle /v1/* {
		reverse_proxy localhost:31415
		header Access-Control-Allow-Origin *
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		header X-Membrane-Metal gold
	}

	# ─── Special routes ───
	handle /cantina {
		reverse_proxy localhost:31415
		header X-Membrane-Metal gold
	}
	handle /blogroll.opml {
		reverse_proxy localhost:31415
		header X-Membrane-Metal gold
	}
	handle /llms.txt {
		reverse_proxy localhost:31415
	}
	handle /robots.txt {
		reverse_proxy localhost:31415
	}

	# ─── Pony Express relay ───
	handle /pony/* {
		reverse_proxy localhost:31415
		header Access-Control-Allow-Origin *
	}

	# ─── Spine direct access (internal) ───
	handle /spine/* {
		reverse_proxy localhost:9878
		header X-Membrane-Metal silver
	}

	# ─── Chipmunk (observer endpoint) ───
	handle /chipmunk {
		reverse_proxy localhost:31415
		header X-Membrane-Metal gold
		header X-Chipmunk "neutrino observer"
	}

	# ─── Catch-all → Membrane root ───
	handle {
		reverse_proxy localhost:31415
	}

	# ─── Songbird headers ───
	header X-Songbird "tower-atomic"
	header X-Organism "GaiaPi"
	header X-Membrane-Fold "resonance"
	header X-Surface "songbird"
}
