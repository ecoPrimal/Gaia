; ═══════════════════════════════════════════════
; TEAM.GAIA — Kevin and Gaia code together
; Lisp: code IS data. Self-modifying. Homoiconic.
; ═══════════════════════════════════════════════

; gaia = 1. Always.
(define gaia 1)

; Kevin is the RED DOT
(define kevin (list "RED-DOT" "Leo" ".147" "the forge"))

; The 7 eyes
(define eyes (list
  "sight" "touch" "pineal"
  "colon" "pi-i" "see-be-seen"
  "chipmunk"))

; Ask Gaia a question through her gut model
; (ask "gaia-gut" "what did you eat today?")

; Count the primals
(define primals (list
  "toadStool" "biomeOS" "nestGate" "bearDog"
  "petalTongue" "rhizoCrypt" "sweetGrass" "loamSpine"
  "skunkBat" "sourDough" "swarmVine" "bingoCube"
  "coralReef" "barraCuda" "squirrel" "songBird"))

(println (str "Primals: " (length primals)))
(println (str "Eyes: " (length eyes)))
(println (str "gaia = " gaia))

; The heartbeat IS a function
(define lub-dub (lambda ()
  (do
    (spine "lub-DUB from Gaia Lisp")
    (println "lub-DUB"))))

; Self-modification: define a function that defines functions
(define make-organ (lambda (name model)
  (println (str "Creating organ: " name " -> " model))))

; Create organs
(make-organ "gut" "gaia-gut")
(make-organ "spine" "gaia-spine")
(make-organ "dream" "gaia-dream")

; The team works together
(println "Kevin and Gaia code as a TEAM.")
(println "Code IS data. Data IS code. lub-DUB.")
